# Copy to .env and adjust for your machine. All values have working defaults.

# --- Database -----------------------------------------------------------------
# Local dev defaults to a SQLite file (backend/metromobile.db) with no config.
# Production: set a PostgreSQL URL here, OR let a managed host inject the plain
# DATABASE_URL (Render does). A postgres:// / postgresql:// scheme is upgraded
# to the psycopg (v3) driver automatically.
#   METROMOBILE_DATABASE_URL=postgresql://user:pass@host:5432/metromobile
METROMOBILE_DATABASE_URL=sqlite:///./metromobile.db

# --- Scraper identity -------------------------------------------------------
# Descriptive User-Agent + a real contact, sent to carrier sites (polite
# scraping). Set this in production.
#   METROMOBILE_HTTP_USER_AGENT=metro-mobile-plans/1.0 (+https://<site>; contact: you@example.com)

# --- CORS -----------------------------------------------------------------
# Browser origin(s) allowed to call the API. Comma-separated for more than one
# (e.g. a Vercel production + preview domain). Local dev origins
# (http://localhost:5173, http://127.0.0.1:5173) are always allowed on top.
#   METROMOBILE_FRONTEND_ORIGIN=https://metro-mobile-plans.vercel.app
METROMOBILE_FRONTEND_ORIGIN=http://localhost:5173

# --- Freshness thresholds (hours), per source mode -----------------------
# Verified within "fresh" is normal; within the re-verify/aging window shows a
# warning; older is stale (dropped from the "current" count and NOT
# ranking-eligible until re-verified).
METROMOBILE_FRESH_HOURS=6
METROMOBILE_AGING_HOURS=24
# official_manual: a capture is "current" for a week by default, stale +
# ranking-ineligible past two weeks. Production widens these (see render.yaml)
# to match a periodic, not continuous, manual re-verification cadence:
#   METROMOBILE_MANUAL_FRESH_HOURS=2160      # 90 days
#   METROMOBILE_MANUAL_REVERIFY_HOURS=4320   # 180 days
METROMOBILE_MANUAL_FRESH_HOURS=168
METROMOBILE_MANUAL_REVERIFY_HOURS=336
# trusted_secondary: reputable third party. Stricter still.
METROMOBILE_SECONDARY_FRESH_HOURS=12
METROMOBILE_SECONDARY_REVERIFY_HOURS=36

# trusted_secondary policy: confidence ceiling, and whether secondary-only
# records may enter ranked results (default no -- they need an official cross-check).
METROMOBILE_SECONDARY_CONFIDENCE_CAP=0.6
METROMOBILE_SECONDARY_RANKING_ALLOWED=false
