# Frontend build-time config for Vite. Copy to `.env` for local overrides.
#
# Local dev: leave as-is (the backend runs on http://localhost:8000).
# Production (Vercel): set this to the deployed Render backend, e.g.
#   VITE_API_BASE_URL=https://metromobile-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Canonical/live site URL — used for <link rel="canonical"> and the Open Graph /
# Twitter share tags in index.html. Defaults to the current Vercel URL; set this
# when the site moves to a custom domain (no trailing slash), e.g.
#   VITE_SITE_URL=https://metromobileplans.com
# VITE_SITE_URL=https://metro-mobile-plans.vercel.app
