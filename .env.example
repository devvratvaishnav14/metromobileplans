# Frontend build-time config for Vite. Copy to `.env` for local overrides.
#
# Local dev: leave as-is (the backend runs on http://localhost:8000).
# Production (Vercel): set this to the deployed Render backend, e.g.
#   VITE_API_BASE_URL=https://metromobile-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000
